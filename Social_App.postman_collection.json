                    "key": "{{x-forwarded-for}}",
                    "value": "{{ipAddress}}"
                  },
                  {
                    "key": "Authorization",
                    "value": "{{BEARER_ACCESS_TOKEN}}"
                  }
                ],
                "url": {
                  "raw": "{{BASE_URL}}/user/{{profileId}}",
                  "host": [
                    "{{BASE_URL}}"
                  ],
                  "path": [
                    "user",
                    "{{profileId}}"
                  ]
                }
              },
              "response": []
            }
          ]
        }
      ]
    }
  ]
}